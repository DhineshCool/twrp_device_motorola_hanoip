# Recovery policies for hanoip
recovery_only(`
  allow recovery block_device:dir { open read search };
  allow recovery userdata_block_device:blk_file rw_file_perms;
  allow recovery metadata_block_device:blk_file rw_file_perms;
  allow recovery boot_block_device:blk_file rw_file_perms;
  allow recovery super_block_device:blk_file rw_file_perms;
  allow recovery kmsg_device:chr_file rw_file_perms;
  allow recovery sysfs_devices_block:dir { open read search };
  allow recovery sysfs_devices_block:file rw_file_perms;
')
